{
  "name": "hello-beauty-kundenportal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/scan-secrets.mjs --build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test": "playwright test",
    "scan:secrets": "node scripts/scan-secrets.mjs --build",
    "hooks:install": "git config core.hooksPath .githooks",
    "env:init": "node scripts/env-local.mjs init",
    "env:check": "node scripts/env-local.mjs check",
    "db:link": "node scripts/supabase-cli.mjs link",
    "db:push": "node scripts/supabase-cli.mjs db push",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.7",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "typescript": "5.9.3"
  }
}
