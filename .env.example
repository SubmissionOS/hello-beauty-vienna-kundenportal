# Hello Beauty Kundenportal – alle Variablen, Werte nur in Vercel bzw. .env.local eintragen.

# Teil 1
# Öffentliche Basis-URL (überschreibt die Origin für den QR-Code), z. B. https://app.example.at
NEXT_PUBLIC_APP_URL=
# true = Button „Als Demo-Kundin ansehen“ und Demo-Hinweise anzeigen
NEXT_PUBLIC_DEMO_MODE=
# Datenquelle: mock (Standard) | supabase (Teil 2)
NEXT_PUBLIC_DATA_ADAPTER=
# Anmeldung: mock (Standard) | supabase (Teil 2)
NEXT_PUBLIC_AUTH_ADAPTER=

# Teil 2 – Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Teil 2 – E-Mail-Versand der 6-stelligen Codes (SMTP für Supabase Auth)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=

# Teil 2 – SMS-Erinnerungen (Anbieter noch offen)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Teil 2 – Zahlung (Stripe, erst nach Freigabe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Teil 2 – Rechtliches / Salon
NEXT_PUBLIC_SALON_WEBSITE_URL=
