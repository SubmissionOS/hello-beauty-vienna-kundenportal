# Hello Beauty Kundenportal – alle Variablen ohne Werte. Kopie als .env.local: npm run env:init

# Öffentlich. Projekt-URL. Vercel: ja (Production + Preview).
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlich (darf ins Frontend, RLS schützt die Daten). Vercel: ja.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Öffentlich. mock | supabase. Vercel: ja (supabase).
NEXT_PUBLIC_DATA_ADAPTER=

# Öffentlich. mock | supabase. Vercel: ja (supabase).
NEXT_PUBLIC_AUTH_ADAPTER=

# Öffentlich. true zeigt „Als Demo-Kundin ansehen“. Vercel: nur wo die Demo gewünscht ist.
NEXT_PUBLIC_DEMO_MODE=

# Öffentlich. Feste App-Adresse für den QR-Code, leer = aktuelle Adresse. Vercel: ja, sobald die Subdomain steht.
NEXT_PUBLIC_APP_URL=

# Öffentlich. Basis für Impressum/Datenschutz-Links, leer = https://hellobeautysalon.at. Vercel: optional.
NEXT_PUBLIC_SALON_WEBSITE_URL=

# PRIVAT, nur Server (umgeht RLS!). Dashboard → Project Settings → API Keys → Secret keys → sb_secret_… Vercel: ja, als Sensitive.
SUPABASE_SECRET_KEY=

# PRIVAT, nur lokal für die Supabase-CLI. Dashboard → Account (oben rechts) → Access Tokens → Generate new token (sbp_…). Vercel: NIE.
SUPABASE_ACCESS_TOKEN=

# PRIVAT, nur lokal für die CLI (Migrationen). Dashboard → Project Settings → Database → Database password (ggf. „Reset“). Vercel: NIE.
SUPABASE_DB_PASSWORD=

# PRIVAT, nur Server. Selbst wählen, mind. 24 zufällige Zeichen (Passwort der Demo-Kundin, wird nie angezeigt). Vercel: ja, als Sensitive, nur mit Demo-Modus.
DEMO_CUSTOMER_PASSWORD=

# PRIVAT, vorbereitet. resend.com → API Keys (re_…). SMTP-Passwort in Supabase und Versand der Benachrichtigungs-Mails. Vercel: ja, als Sensitive, sobald vorhanden.
RESEND_API_KEY=

# Absender der Benachrichtigungs-Mails, z. B. Hello Beauty <termine@hellobeautysalon.at> (Domain muss bei Resend bestätigt sein). Vercel: ja.
NOTIFY_FROM_EMAIL=

# Später (SMS-Erinnerungen, Anbieter offen). Vercel: später.
SMS_PROVIDER=

# PRIVAT, später. Vercel: später, als Sensitive.
SMS_API_KEY=

# Öffentlich, später (Zahlung erst nach Freigabe). Stripe → Developers → API keys (pk_…). Vercel: ja, sobald gewünscht.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PRIVAT, später. Schlüssel der Plattform (Stripe Connect), sk_… bzw. rk_…. Vercel: später, als Sensitive.
STRIPE_SECRET_KEY=

# PRIVAT, später. Stripe → Webhooks → Endpoint /api/payments/webhook → Signing secret (whsec_…). Vercel: später, als Sensitive.
STRIPE_WEBHOOK_SECRET=

# Später. Verbundenes Konto des Salons bei Stripe Connect (acct_…). Vercel: später.
STRIPE_CONNECT_ACCOUNT_ID=

# PRIVAT. Passwort des Demo-Zugangs inhaberin.demo@example.com (CRM). Wird mit env:ensure erzeugt und per crm:env ins CRM übernommen. Vercel: nein.
TEAM_DEMO_PASSWORD_OWNER=

# PRIVAT. Passwort des Demo-Zugangs mitarbeiterin1.demo@example.com (CRM). Vercel: nein.
TEAM_DEMO_PASSWORD_STAFF1=

# PRIVAT. Passwort des Demo-Zugangs mitarbeiterin2.demo@example.com (CRM). Vercel: nein.
TEAM_DEMO_PASSWORD_STAFF2=

# Signierte CRM-Schnittstelle /api/crm/v1 (Teil 4). Leer/aus: abgeschaltet, weil das CRM direkt auf die gemeinsame DB zugreift. Vercel: nicht setzen.
CRM_API_ENABLED=

# PRIVAT, nur Server. HMAC-Schlüssel der CRM-Schnittstelle /api/crm/v1 (Schlüssel-ID hello-beauty-crm). Wird mit env:ensure erzeugt; derselbe Wert kommt ins CRM. Vercel: ja, als Sensitive.
CRM_BRIDGE_SECRET=

# Öffentlich. Web-Push (VAPID, P-256), wird mit env:ensure erzeugt. Vercel: ja.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PRIVAT, nur Server. Gehört zum öffentlichen VAPID-Schlüssel – nie einzeln tauschen. Vercel: ja, als Sensitive.
VAPID_PRIVATE_KEY=

# Kontakt für die Push-Dienste (RFC 8292). Vercel: ja.
VAPID_SUBJECT=

# PRIVAT, nur Server. Schützt /api/notifications/process (Versand der Warteschlange, Aufruf per Cron). Wird mit env:ensure erzeugt. Vercel: ja, als Sensitive.
NOTIFY_WORKER_SECRET=
